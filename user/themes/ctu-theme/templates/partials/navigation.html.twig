{% macro loop(page) %}
    {% for p in page.children.visible %}
        {% if p.children.visible.count > 0 %}
            <li class="menu__item menu__item--has-dropdown">
                <button class="menu__button">
                    {{ p.menu|e }}
                    <span class="menu__arrow"></span>
                </button>
                <ul class="menu__submenu">
                    {{ _self.loop(p) }}
                </ul>
            </li>
        {% else %}
            <li class="menu__sumbmenu-item ">
                <a href="{{ p.url|e }}" class="menu__submenu-link">
                    {{ p.menu|e }}
                </a>
            </li>
        {% endif %}
    {% endfor %}
{% endmacro %}

<ul class="menu__list">
    {{ _self.loop(pages) }}

    {% for mitem in site.menu %}
        <li>
            <a href="{{ mitem.url|e }}">
                {% if mitem.icon %}<i class="fa fa-{{ mitem.icon|e }}"></i>{% endif %}
                {{ mitem.text|e }}
            </a>
        </li>
    {% endfor %}

</ul>
