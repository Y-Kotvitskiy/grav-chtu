<!DOCTYPE html>
<html lang="{{ (grav.language.getActive ?: grav.config.site.default_lang)|e }}" class="page">
<head>
    {% block head %}
        <meta charset="utf-8"/>
        <title>{% if header.title %}{{ header.title|e }} | {% endif %}{{ site.title|e }}</title>

        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% include 'partials/metadata.html.twig' %}

        <link rel="icon" type="image/png" href="{{ url('theme://images/logo.png')|e }}"/>
        <link rel="canonical" href="{{ page.canonical(true)|e }}"/>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
              rel="stylesheet">

    {% endblock head %}
    {% block stylesheets %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
          integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
          crossorigin="anonymous" referrerpolicy="no-referrer"/>
    {# Во время разработки подключаем напрямую, в продакшене — скомпилированный файл #}
    {% if config.system.debugger.enabled %}
        <script type="module" src="http://localhost:5173/@vite/client"></script>
        <script type="module" src="http://localhost:5173/src/main.js"></script>

    {% else %}

        {% set manifest = {} %}
        {% set manifest_path = 'theme://dist/.vite/manifest.json' %}

        {% if file_exists(manifest_path) %}
            {% set content = read_file(manifest_path) %}
            {% if content %}
                {% set manifest = content|json_decode(true) %}
                {% do assets.addCss('theme://dist/' ~ manifest['src/main.js'].css[0]) %}
                {% do assets.addJs('theme://dist/' ~ manifest['src/main.js'].file, { 'type': 'module' }) %}
            {% endif %}
        {% endif %}

    {% endif %}
    {% endblock %}

    {% block javascripts %}
        {#        {% do assets.addJs('jquery', 100) %} #}
        {#        {% do assets.addJs('theme://js/custom.js', {priority: 100, group: 'bottom'}) %} #}
    {% endblock %}

    {% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
    {% endblock %}
</head>
<body id="top" class="page__body {{ page.header.body_classes|e }}">

{% block header %}
    <header class="menu">
        <div class="container">
            <div class="menu__content">
                <a class="menu__logo" href="{{ home_url|e }}">
                    <img class="menu__logo-img" src="{{ url('theme://images/logo.webp') }}"
                         alt="{{ site.title|e }}"/>
                </a>
                {% set schedule_page = pages.find('/passagers/schedule') %}

                {% if schedule_page %}
                    <a href="{{ schedule_page.url }}" class="menu__schedule">
                        {{ schedule_page.title }}
                    </a>
                {% endif %}


                {% block header_navigation %}
                    <button class="menu__toggle" id="mobile-menu" aria-label="Відкрити меню">
                        <span class="menu__bar"></span>
                        <span class="menu__bar"></span>
                        <span class="menu__bar"></span>
                    </button>

                    {% include 'partials/navigation.html.twig' %}
                {% endblock %}
            </div>
        </div>
    </header>
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
    {% set footer_page = page.find('/home/_footer') %}
    <footer class="footer">
        <div class="container">
            <div class="footer__content">
                {{ footer_page.content|raw }}
            </div>
        </div>
    </footer>
{% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}

</body>
</html>
